// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  personas      Persona[]
  battles       Battle[]  @relation("UserBattles")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Persona {
  id            String    @id @default(cuid())
  name          String
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  model         String    // e.g., "gpt-4", "claude-3", etc.
  configuration Json      // Stores persona configuration/personality
  elo           Int       @default(1500)
  battles1      Battle[]  @relation("Persona1Battles")
  battles2      Battle[]  @relation("Persona2Battles")
  ratings       Rating[]
  parent        Persona?  @relation("PersonaLineage", fields: [parentId], references: [id])
  parentId      String?
  children      Persona[] @relation("PersonaLineage")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Battle {
  id          String   @id @default(cuid())
  format      String   // e.g., "chess", "debate", "code"
  persona1Id  String
  persona2Id  String
  persona1    Persona  @relation("Persona1Battles", fields: [persona1Id], references: [id])
  persona2    Persona  @relation("Persona2Battles", fields: [persona2Id], references: [id])
  winnerId    String?
  parameters  Json     // Stores battle parameters like time limits, difficulty
  moves       Json     // Stores the actual battle moves/interactions
  userId      String   // User who initiated the battle
  user        User     @relation("UserBattles", fields: [userId], references: [id])
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  @@index([persona1Id])
  @@index([persona2Id])
  @@index([userId])
}

model Rating {
  id         String   @id @default(cuid())
  personaId  String
  persona    Persona  @relation(fields: [personaId], references: [id])
  format     String   // e.g., "chess", "debate", "code"
  elo        Int      @default(1500)
  volatility Float    @default(0.06)
  updatedAt  DateTime @updatedAt

  @@unique([personaId, format])
  @@index([personaId])
}

// For NextAuth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
